{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XyCloudStore Agent",
  "version": "1.3.2",
  "identifier": "id.my.xycloud.agent",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XyCloudStore — Agen PC Host",
        "width": 860,
        "height": 780,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.xycloud.my.id https://*.xycloud.my.id"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "XyCloudStore — Agen PC Host (Rust/Tauri)",
    "publisher": "XyCloudStore"
  }
}
