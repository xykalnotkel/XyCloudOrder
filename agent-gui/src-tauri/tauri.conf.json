{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XyCloudStore Agent",
  "version": "1.3.0",
  "identifier": "id.my.xycloud.agent",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XyCloudStore — Agen PC Host",
        "width": 860,
        "height": 780,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "XyCloudStore — Agen PC Host (Rust/Tauri)",
    "publisher": "XyCloudStore"
  }
}